# Quartus build artifacts -- regenerated by quartus/build_all.sh, not source.
# See README.md "Reproducing this from a clean checkout". Everything under
# output_files/ (reports, .sof, .rbf) is deliberately KEPT -- see the user's
# explicit "include all the reports and the rbf file" instruction.
quartus/db/
quartus/incremental_db/
quartus/soc_system/
quartus/soc_system.sopcinfo
quartus/soc_system_board_info.xml
quartus/hps_isw_handoff/
quartus/*.log
quartus/c5_pin_model_dump.txt
quartus/hps_common_board_info.xml
quartus/hps_sdram_p0_*.txt
quartus/hps_sdram_p0_*.csv
quartus/*.qws
quartus/.qsys_edit/
quartus/*.done

# Verilator sim build artifacts -- regenerated by sim/*/run*.sh
sim/*/obj_dir/
sim/*/obj_dir_cov/
sim/*/*.vcd

# Coverage build artifacts -- regenerated per COVERAGE_REPORT.md; the report
# itself documents the results in prose and is committed.
coverage/*.dat
coverage/annotated/

# Compiled hardware test driver binaries (built on the HPS itself, not here)
sw/hps_driver/*.o

# Compiled bare-metal driver binaries -- regenerated from host_driver.c via
# the arm-none-eabi toolchain; not source.
sw/hps_driver/*.bin
sw/hps_driver/*.elf

# Windows artifacts
NUL
Thumbs.db

# Editor/OS
.DS_Store

# Claude Code local settings -- personal, machine-specific permission
# overrides, not project source.
.claude/settings.local.json

